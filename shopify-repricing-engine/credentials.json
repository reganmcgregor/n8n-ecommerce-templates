{
  "template": "Shopify repricing engine",
  "credentials": [
    {
      "name": "Shopify client credentials",
      "type": "httpCustomAuth",
      "nodes": [
        "Get Shopify token",
        "Get Shopify token for Click"
      ],
      "help": "Your Shopify app's client ID and secret (Dev Dashboard > your app > Settings)"
    },
    {
      "name": "Slack bot",
      "type": "slackApi",
      "nodes": [
        "Post the alert",
        "Post the card",
        "Close the old card",
        "Update the message",
        "Reply in thread",
        "Post the digest"
      ],
      "help": "Your Slack app's bot token (OAuth & Permissions)"
    },
    {
      "name": "Slack signing secret",
      "type": "crypto",
      "nodes": [
        "Sign the request"
      ],
      "help": "Your Slack app's Signing Secret (Basic Information)",
      "secret_label": "Slack Signing Secret"
    },
    {
      "name": "Supabase (Postgres)",
      "type": "postgres",
      "supabase_only": true,
      "nodes": [
        "Create pricing_rules",
        "Create price_decisions",
        "Create price_changes",
        "Create pricing_runs",
        "Get the rules",
        "Add the default rule",
        "Get pricing rules",
        "Get competitor listings",
        "Get decisions",
        "Save decisions",
        "Get last run",
        "Log price changes",
        "Save results",
        "Log the run",
        "Get held prices",
        "Save the card",
        "Get the decision",
        "Get the result",
        "Hold the price",
        "Lock the variant",
        "Get the change",
        "Log the revert",
        "Mark it reverted",
        "Lock after revert",
        "Get recent changes",
        "Get recent runs",
        "Get all decisions"
      ],
      "help": "Your Supabase database connection string (Connect > Session pooler), for workflow-supabase.json only"
    }
  ]
}