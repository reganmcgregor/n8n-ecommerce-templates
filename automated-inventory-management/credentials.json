{
  "template": "Automated inventory management",
  "credentials": [
    {
      "name": "Shopify client credentials",
      "type": "httpCustomAuth",
      "nodes": [
        "Get Shopify token",
        "Get Shopify token for Sync",
        "Get Shopify token for Sweep",
        "Get Shopify token for Review"
      ],
      "help": "Your Shopify app's client ID and secret (Dev Dashboard > your app > Settings)"
    },
    {
      "name": "Slack bot",
      "type": "slackApi",
      "nodes": [
        "Feed held",
        "Feed warning",
        "Post summary",
        "Post the card",
        "Update the card",
        "Reply in thread"
