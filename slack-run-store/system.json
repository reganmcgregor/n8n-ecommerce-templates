          "table": "title_drafts",
          "rows": "select id::text as id, new_title as label, 'was: ' || old_title as detail, product_id as value, slack_ts as ts, null::text as channel, \"updatedAt\" as since from title_drafts where status = 'pending'",
          "replay": {
            "approve": "title_approve",
            "reject": "title_reject"
          }
        }
      ]
    },
