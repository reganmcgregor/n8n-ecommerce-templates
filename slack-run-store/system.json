    {
      "slug": "product-data-enrichment",
      "title": "Product attributes",
      "phase": 3,
      "phase_folder": "3-enrich",
      "jobs_prefix": "attributes",
      "lane_names": {
        "every-15-minutes": "extract",
        "every-10-minutes": "review",
        "every-15-minutes-push": "push",
        "run-once-to-set-up": "setup"
      },
      "channels": {
        "Review settings": {
          "slack_channel": "review-attributes"
        }
      },
      "slack": {
        "webhook": "spec-review",
        "action_prefixes": [
          "attr_",
          "bulk_"
        ],
        "channels": [
          "review-attributes"
        ]
      },
      "queues": [
        {
          "key": "attributes",
          "label": "Product attributes",
          "channel": "review-attributes",
          "table": "attribute_values",
          "rows": "select slack_ts as id, case when count(distinct product_id) = 1 then max(product_title) else count(distinct product_id) || ' products: ' || left(string_agg(distinct product_title, ', '), 160) end as label, count(*) || ' values: ' || left(string_agg(key || ' = ' || value, ', '), 240) as detail, case when count(distinct product_id) = 1 then max(product_id) else 'bulk' end as value, slack_ts as ts, max(slack_channel) as channel, min(\"updatedAt\") as since, case when count(distinct product_id) = 1 then 'attr_approve' else 'bulk_approve' end as approve_action, case when count(distinct product_id) = 1 then 'attr_reject' else 'bulk_reject' end as reject_action from attribute_values where review_status = 'pending' and slack_ts is not null group by slack_ts",
          "replay": {
            "approve": "attr_approve",
            "reject": "attr_reject",
            "needs_card_state": true
          }
        }
      ],
      "conductor": {
        "stage": "sources",
        "tag_from": [
          "Extract settings",
          "queue_tag"
        ],
        "pending": "select product_id from attribute_values where review_status = 'pending'"
      }
    },
