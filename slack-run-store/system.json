{
  "_about": "Which template does what in which phase, which Slack channel each settings key posts to, how the router finds each workflow's button taps, which review queues the page and /store status read, and the conductor's stages. build.py reads it; config.json holds your own values.",
  "phases": [
    {
      "phase": 1,
      "name": "Publish products",
      "folder": "1-publish"
    },
    {
      "phase": 2,
      "name": "Maintain products",
      "folder": "2-maintain"
    },
    {
      "phase": 3,
      "name": "Enrich products",
      "folder": "3-enrich"
    },
    {
      "phase": 4,
      "name": "Enrich collections",
      "folder": "4-collections"
    },
    {
      "phase": 5,
      "name": "Distribution",
      "folder": "5-distribution"
    },
    {
      "phase": 6,
      "name": "Bulk operations",
      "folder": "6-bulk"
    }
  ],
  "router_ignore": [
    "link_",
    "pin_open",
    "ig_open",
    "video_watch",
    "acc_link",
    "faq_link"
  ],
  "templates": [
    {
      "slug": "add-products-to-shopify",
      "title": "Add products",
      "phase": 1,
      "phase_folder": "1-publish",
      "starter": true,
      "jobs_prefix": "products",
      "lane_names": {
        "every-day-at-05-00": "ingest",
        "every-6-hours": "token",
        "every-day-at-06-00": "detect",
        "run-once-to-set-up": "setup"
      },
      "channels": {
        "*": {
          "slack_channel": "log-ingest"
        },
        "Detect settings": {
          "slack_channel": "review-supplier-offers"
        },
        "Review settings": {
          "slack_channel": "review-supplier-offers"
        },
        "Draft settings": {
          "slack_channel": "review-product-drafts"
        },
        "Go live settings": {
          "slack_channel": "review-product-drafts"
        }
      },
      "slack": {
        "webhook": "product-review",
        "action_prefixes": [
          "product_",
          "draft_"
        ],
        "channels": [
          "review-supplier-offers",
          "review-product-drafts"
        ]
      },
      "queues": [
        {
          "key": "supplier-offers",
          "label": "Supplier offers",
          "channel": "review-supplier-offers",
          "table": "offers",
          "rows": "select id::text as id, case when title ilike brand || ' %' then title else concat_ws(' ', brand, coalesce(title, source_sku)) end as label, concat_ws(' · ', mpn, source, case when cost is not null then 'cost ' || round(cost::numeric, 2) end) as detail, id || ':' || card_nonce as value, card_ts as ts, null::text as channel, \"updatedAt\" as since from offers where status = 'pending_review' and card_nonce is not null",
          "replay": {
            "approve": "product_approve",
            "reject": "product_reject",
            "approve_label": "Approve",
            "reject_label": "Reject"
          }
        },
        {
          "key": "product-drafts",
          "label": "Product drafts",
          "channel": "review-product-drafts",
          "table": "offers",
          "rows": "select id::text as id, case when title ilike brand || ' %' then title else concat_ws(' ', brand, coalesce(title, source_sku)) end as label, concat_ws(' · ', mpn, product_id) as detail, id || ':' || card_nonce as value, draft_card_ts as ts, null::text as channel, \"updatedAt\" as since from offers where status = 'drafted' and card_nonce is not null",
          "replay": {
            "approve": "draft_golive",
            "reject": "draft_reject",
            "approve_label": "Go live",
            "reject_label": "Reject"
          }
        }
      ]
    },
    {
      "slug": "ai-product-titles",
      "title": "AI product titles",
      "phase": 1,
      "phase_folder": "1-publish",
      "jobs_prefix": "titles",
      "lane_names": {
        "every-3-hours": "write",
