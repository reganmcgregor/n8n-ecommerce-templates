      "slug": "product-manuals-spec-sheets",
      "title": "Manuals and spec sheets",
      "phase": 3,
      "phase_folder": "3-enrich",
      "jobs_prefix": "documents",
      "lane_names": {
        "every-hour-find": "find",
        "every-10-minutes-review": "review",
        "every-10-minutes-publish": "publish",
        "run-once-to-set-up": "setup"
      },
      "channels": {
        "Review settings": {
          "slack_channel": "review-documents"
        },
        "Publish settings": {
          "slack_channel": "log-sources"
        }
      },
      "slack": {
        "webhook": "product-documents-review",
        "action_prefixes": [
          "doc_"
        ],
        "channels": [
          "review-documents"
        ]
      },
      "queues": [
        {
          "key": "documents",
          "label": "Manuals and spec sheets",
          "channel": "review-documents",
          "table": "documents",
          "rows": "select id::text as id, coalesce(product_title, model) || ': ' || coalesce(doc_title, doc_type) as label, concat_ws(' · ', doc_type, url) as detail, id::text as value, slack_ts as ts, slack_channel as channel, \"updatedAt\" as since from documents where status = 'in_review'",
          "replay": {
            "approve": "doc_approve",
            "reject": "doc_reject"
          }
        }
      ],
      "conductor": {
        "stage": "sources",
        "tag_from": [
          "Find settings",
          "queue_tag"
        ],
        "pending": "select product_id::text as product_id from documents where status in ('review', 'in_review')"
      }
    },
