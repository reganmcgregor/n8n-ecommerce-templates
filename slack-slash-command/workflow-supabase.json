              "id": "acf35e57-0ad5-5ab5-b53f-cf2bb3ed8ee6",
              "name": "seconds",
              "type": "number",
              "value": "={{ Math.round(($now.toMillis() - $('Read the command').first().json.started_at) / 1000) }}"
            }
          ]
        },
        "options": {}
      },
