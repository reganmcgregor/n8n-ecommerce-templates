      "name": "Post when it's done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3060,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Read the command').first().json.response_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const c = $('Read the command').first().json;\n  const label = $('Command settings').first().json.jobs.find(j => j.key === c.job).label;\n  const took = $json.seconds < 90 ? $json.seconds + ' s' : Math.round($json.seconds / 60) + ' min';\n  const text = $json.result === 'finished'\n    ? ':white_check_mark: <@' + c.user_id + '> ran *' + label + '*' + (c.args ? ' for ' + c.args : '') + '. It finished in ' + took + '.'\n    : ':x: *' + label + '* failed after ' + took + ': ' + $json.error;\n  return JSON.stringify({ response_type: 'in_channel', replace_original: false, text });\n})() }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "notes": "Slack's response_url needs no token and works for 30 minutes. in_channel so the channel sees the result."
    },
