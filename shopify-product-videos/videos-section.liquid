{%- assign videos = product.metafields.custom.videos.value -%}
{%- if videos != blank -%}
  <div class="product-videos">
    <h2 class="product-videos__heading h3">Videos</h2>
    <div class="product-videos__grid">
      {%- for video in videos -%}
        {%- assign id = video.video_id.value -%}
        <figure class="product-videos__item">
          <button type="button" class="product-videos__play" data-video-id="{{ id | escape }}" aria-label="Play {{ video.title.value | escape }}">
            <img src="https://i.ytimg.com/vi/{{ id | escape }}/hqdefault.jpg" alt="" width="480" height="360" loading="lazy">
            <span class="product-videos__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
          </button>
          <figcaption>
            <a href="{{ video.url.value | escape }}" target="_blank" rel="noopener">{{ video.title.value | escape }}</a>
            <span>By {{ video.channel_name.value | escape }}{% case video.coverage.value %}{% when 'comparison' %} · Comparison{% when 'mention' %} · Brief mention{% endcase %}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
  <style>
    .product-videos__heading { margin: 0 0 1.25rem; }
    .product-videos__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.75rem; }
    .product-videos__item { margin: 0; }
    .product-videos__play, .product-videos__item iframe { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; border-radius: 0.75rem; overflow: hidden; background: #111; cursor: pointer; }
    .product-videos__play img { width: 100%; height: 100%; object-fit: cover; }
    .product-videos__icon { position: absolute; inset: 0; margin: auto; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: rgb(0 0 0 / 70%); color: #fff; }
    .product-videos__icon svg { width: 1.75rem; height: 1.75rem; margin-left: 0.2rem; }
    .product-videos__play:hover .product-videos__icon, .product-videos__play:focus-visible .product-videos__icon { background: #000; }
    .product-videos__item figcaption { display: grid; gap: 0.25rem; margin-top: 0.75rem; }
    .product-videos__item figcaption a { font-weight: 600; color: inherit; }
    .product-videos__item figcaption span { opacity: 0.7; font-size: 0.9em; }
  </style>
  <script>
    document.querySelectorAll('.product-videos__play').forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.dataset.videoId;
        if (!/^[A-Za-z0-9_-]{11}$/.test(id)) return;
        var player = document.createElement('iframe');
        player.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&playsinline=1';
        player.title = button.getAttribute('aria-label');
        player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        player.allowFullscreen = true;
        button.replaceWith(player);
        player.focus();
      }, { once: true });
    });
  </script>
{%- endif -%}
